JS_STAT = '''
try {
  var f = new java.io.File(__PATH__);
  pcd_write(__FILE__, 'STAT|' + f.exists() + '|' + f.isFile() + '|' + f.length());
} catch (e) { pcd_write(__FILE__, 'PCERR:' + e); }
